pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello World'
            }
        }
        stage('Goodbye') {
            steps {
                echo 'Goodbye World'
            }
        }
        stage('OK') {
            steps {
                sleep 5
                echo 'I\'m ok'
            }
        }
    }
}
